  "demonstratedResidualFindings": [
    {
      "id": "FAILED_CASE_RECEIPT_STILL_ADMITTED",
      "priority": "P2 evidence integrity",
      "observation": "Status-based receipt only requires nonempty cases. A receipt with status COMPLETE, no top error and cases:[{ok:false}] is accepted; aggregate becomes COMPLETE in the literal corrected runner VM.",
      "consequence": "A contradictory per-case failure does not prevent positive aggregate status.",
      "recommendation": "Require every recorded case to be a non-null object with ok===true (and reject explicit case error/failure where schema allows it); retain programme-specific schema constraints."
    },
    {
      "id": "AVAILABLE_HARNESS_IDENTITY_NOT_BOUND",
      "priority": "P2 provenance",
      "observation": "row.harnessSha256 is recorded from before, but receipt.harness.path/sha256 (or packaged.probeSha256) is not compared. Explicit wrong receipt.harness identity still permits aggregate COMPLETE.",
      "consequence": "Fresh directory and consistent package identity do not establish that the evidence was produced by the selected harness.",
      "recommendation": "When the programme emits harness identity/probeSha256, require exact expected path/hash; explicitly state identity unavailable for other programmes and bind their execution evidence through external context."
    }
  ],
