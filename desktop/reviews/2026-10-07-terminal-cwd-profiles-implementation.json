  "interfaces": {
    "cwd": {
      "constructor": "CwdAuthority({pickDirectory,protectedRoots,inspectDirectory,authorize,captureAdmission,maxGrants=64,maxPending=8})",
      "pick": "pick(grant):Promise<{cwdId,projectId,displayPath}>",
      "resolve": "resolve(grant,cwdId):Promise<string>",
      "lifecycle": [
        "revoke() invalidates token map and pending generation",
        "dispose() permanently refuses all operations"
      ],
      "pickerProvider": "pickDirectory(grant):Promise<{canceled:boolean,filePaths:string[]}>",
      "inspectionProvider": "inspectDirectory(path):Promise<{canonicalPath,identity,directory:true,reparse:false,ancestors:[{path,identity,directory:true,reparse:false},...]}>; ancestry covers drive root through leaf",
      "scope": "authorize(grant,method) must return exactly true from live main-owned policy; captureAdmission(grant) returns a registry guard whose isCurrent returns exactly true",
      "tokenBinding": "private authority instance/run, projectId, epoch and monotonic generation; public token does not retain originating window lease, so a fresh eligible same-project peer can resolve after original view retires"
    },
    "profiles": {
      "factory": "createShellProfileCatalogue({getSystemDirectory,inspectExecutable,readEnvironment,authorize,captureAdmission,privateEnvironmentKeys=[],maxPending=8})",
      "list": "listShellProfiles():Promise<Array<{profileId,label,available}>>",
      "resolve": "resolveShellProfile(profileId):Promise<{executable,args,env}>",
      "moduleDefaults": "Unconfigured exported listShellProfiles/resolveShellProfile fail SENDER_REFUSED; no ambient process.env or discovery",
      "inspectionProvider": "inspectExecutable(path):Promise<{canonicalPath,identity,file:true,reparse:false,ancestors:[{path,identity,directory:true,reparse:false},...]}>; ancestry covers drive root through executable parent",
      "scope": "factory callbacks are bound by main to a stable real captured request/caller, never a mutable renderer identity; authorize(method) and captureAdmission(method) rechecked around every await",
      "initialProfile": "powershell; Windows PowerShell; trusted systemDirectory/WindowsPowerShell/v1.0/powershell.exe",
      "argv": [
        "-NoLogo",
        "-NoProfile"
      ],
      "lifecycle": [
        "revoke() invalidates pending generation and pinned discovery",
        "dispose() permanently refuses all operations"
      ]
    }
  },
  "decisions": {
    "paths": "Local absolute drive paths and roots only; normalize separators and traversal before protected boundary checks. Refuse UNC/device/extended/relative paths, ADS colon, control/NUL, unpaired surrogate, forbidden Windows characters, trailing dot/space and reserved device aliases.",
    "identity": "Complete immutable signature of provider-supplied canonical/leaf/ancestor identities; inspect protected roots and selected path at pick and resolve. Profile executable and directory ancestry pinned across list/resolve until revoke; inspect again after environment await.",
    "rolePolicy": "Existing TerminalPolicy controls workspace/terminal rights; no new registry role or inferred write authority.",
    "environment": "Copied native-owned data snapshot; require nonempty SystemRoot and PATH; strip NODE_/ELECTRON_/VSCODE_/SIREN_ prefixes, CHROME_LOG_FILE, PSModulePath and explicit privateEnvironmentKeys case-insensitively; refuse case-folded duplicate keys. Never add app credentials or accept renderer env. Inherited OS user variables may contain user secrets; no universal secret-removal claim.",
    "modulePath": "PSModulePath omission is explicit, not silently replaced with an OS-only guess; inherited custom module paths may be affected and real startup behavior is unqualified.",
    "limits": {
      "cwdTokens": 64,
      "cwdPending": 8,
      "profilePending": 8,
      "protectedRoots": 16,
      "ancestorRecords": 128,
      "pathCharacters": 32768,
      "identityCharacters": 256,
      "environmentVariables": 512,
      "environmentValueCharacters": 32768,
      "environmentTotalUtf8Bytes": 262144,
      "privateEnvironmentKeyNames": 128
    },
    "pending": "No timer/retry or fake cancellation. An unresolved injected provider retains its bounded pending slot until completion; revoke makes its eventual result unusable. No eviction of active cwd authority."
  },
