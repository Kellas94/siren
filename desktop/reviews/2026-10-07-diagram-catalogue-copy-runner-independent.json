  "findings": [
    {
      "id": "COPY_RECEIPT_ABSENCE_SKIPS_HASHING",
      "priority": "P1 evidence integrity",
      "line": 18,
      "demonstrated": true,
      "observation": "verifyCopies silently skips any immediate directory whose BUILD-IDENTITY.json yields ENOENT and only requires at least one remaining copy. An executed retained copy without that file is not hashed and the aggregate can still say COMPLETE.",
      "proof": "Own exact-runner inert VM: all 13 rows COMPLETE with one valid-copy and one skipped lost-receipt-copy each; no hash call for the omitted copies.",
      "correction": "Bind each programme to its expected exact copy roots or an independently recorded creation roster; require every expected receipt and hash each expected copy. packaged.mjs creates three roots, not just two."
    },
    {
      "id": "FAILURE_RECEIPT_PREVENTS_POSTRUN_HASHES",
      "priority": "P2 adverse evidence retention",
      "line": 33,
      "demonstrated": true,
      "observation": "Successful receipt is asserted before verifyCopies. A legitimate ADVERSE native result therefore bypasses all copied ASAR/runtime/helper verification for that programme.",
      "proof": "Own exact-runner inert VM yields ADVERSE and zero hash calls. Actual ROOT original runner also stops at diagram-pan-release code1 with no postRunCopies and Successful actual native receipt required.",
      "correction": "Capture copied binary verification independently of child verdict, preserving both outcome and verification errors; always retain adversarial failing-run copy hashes."
    },
    {
      "id": "CONTRADICTORY_RECEIPT_ACCEPTED",
      "priority": "P2 evidence integrity",
      "line": 33,
      "demonstrated": true,
      "observation": "The OR accepts status ADVERSE alongside completed:true. There is no rejection of explicit failure fields, per-case false values or programme-specific schema.",
      "proof": "Own exact-runner inert VM supplies status ADVERSE+completed:true to every row; final status is COMPLETE with exit0 and valid hashes.",
      "correction": "Use explicit schemas per programme: status programmes require COMPLETE, no conflicting completed:false/error/failed cases; completed programmes require true and no contradictory status/error. Preserve allowed field differences intentionally."
    },
    {
      "id": "STALE_OR_CROSS_PROGRAMME_EVIDENCE_ACCEPTED",
      "priority": "P2 provenance boundary",
      "line": 32,
      "demonstrated": true,
      "observation": "Runner accepts the last arbitrary stdout evidence path without freshness, containment, uniqueness, receipt harness identity or run binding. The same old valid evidence directory can satisfy all programme names.",
      "proof": "Own exact-runner inert VM returns a single pre-existing evidence root for all 13; aggregate COMPLETE. This demonstrates missing provenance validation, not malicious behavior or a false current run.",
      "correction": "Record pre-run evidence roots, require new role-appropriate unique root contained within its expected evidence parent, bind harness digest/source package identity and launched copy to each row; use an explicit run nonce where feasible."
    }
  ],
