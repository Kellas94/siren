  "attribution": "Findings refer to captured pre-repair bytes. Four files changed during owner implementation; those repaired bytes were not re-reviewed or executed.",
  "findings": [
    {
      "id": "AP1",
      "priority": 2,
      "title": "Named graph palette collapses to mode",
      "paths": [
        "src/ui/shared/shell.js:46",
        "src/ui/windows/diagram.js:87",
        "src/ui/diagram/vector.js:36"
      ],
      "detail": "Named ID survives in dataset/CSS/event, but legacy fields receive theme.mode and Mermaid receives dark/default. This affects preview as well as utility output; preview is not an already-correct graph palette oracle."
    },
    {
      "id": "AP2",
      "priority": 2,
      "title": "Present ignores forced native mode",
      "paths": [
        "src/ui/presentation/render.js:29",
        "src/main.mjs:535",
        "src/windows/presentation.mjs:89"
      ],
      "detail": "Present utility independently reads OS matchMedia without app preference. SVG exports already carry resolved light/dark from Diagram, so the forced-mode transport finding belongs to Present."
    },
    {
      "id": "AP3",
      "priority": 2,
      "title": "Canvas, title and public cards use separate fixed palettes",
      "paths": [
        "src/ui/diagram/vector.js:25",
        "src/ui/presentation/render.js:30",
        "src/ui/presentation/cards.js",
        "src/ui/shared/chrome.css:23"
      ],
      "detail": "Named graph fallback alone does not unify exported background/title, public cards/sections and preview canvas. Source-owned background must retain precedence."
    },
    {
      "id": "AP4",
      "priority": 2,
      "title": "Current Presenter frame is not refreshed on appearance change",
      "paths": [
        "src/ui/presentation/window.js"
      ],
      "detail": "No siren-appearance listener exists in inspected controller. Main resolution alone applies only to the next navigation/refresh."
    }
  ],
