import test from 'node:test';import assert from 'node:assert/strict';import {win32 as path} from 'node:path';
import {dispatchTerminalRequest} from '../src/terminal/contracts.mjs';
async function implementation(){try{return await import('../src/terminal/profiles.mjs');}catch(e){if(e.code==='ERR_MODULE_NOT_FOUND')assert.fail('Shell profile catalogue implementation is missing');throw e;}}
const executable='C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe';
function file(p){const parts=path.dirname(p).slice(3).split('\\');return {canonicalPath:p,identity:'executable-id',file:true,reparse:false,ancestors:['C:\\',...parts.map((_,i)=>path.join('C:\\',...parts.slice(0,i+1)))].map(q=>({path:q,identity:'dir:'+q,directory:true,reparse:false}))};}
async function fixture(extra={}){const {createShellProfileCatalogue}=await implementation();assert.equal(typeof createShellProfileCatalogue,'function');const state={allowed:true,generation:0,calls:[],hook:async()=>{},file:file(executable),env:{SystemRoot:'C:\\Windows',PATH:'C:\\Windows\\System32',TEMP:'C:\\Temp',USERNAME:'human'}};const call=async(type,value)=>{state.calls.push(type);await state.hook(type);return value();};const catalogue=createShellProfileCatalogue({authorize:()=>state.allowed,captureAdmission:()=>{const n=state.generation;return {isCurrent:()=>state.generation===n};},getSystemDirectory:()=>call('system',()=> 'C:\\Windows\\System32'),inspectExecutable:p=>call('inspect',()=>{assert.equal(p,executable);return state.file;}),readEnvironment:()=>call('env',()=>state.env),...extra});return {catalogue,state};}
const rejects=(fn,code)=>assert.rejects(fn,e=>e?.code===code);

test('profile defaults do not discover files or issue a usable executable',async()=>{const {listShellProfiles,resolveShellProfile,createShellProfileCatalogue}=await implementation();await rejects(()=>listShellProfiles(),'SENDER_REFUSED');await rejects(()=>resolveShellProfile('powershell'),'SENDER_REFUSED');let calls=0;const a=createShellProfileCatalogue({getSystemDirectory:()=>{calls++;return 'C:\\Windows\\System32';}});await rejects(()=>a.listShellProfiles(),'SENDER_REFUSED');assert.equal(calls,0);});
test('profile list is immutable and exposes no native executable argv or environment',async()=>{const {catalogue:a}=await fixture();const result=await a.listShellProfiles();assert.deepEqual(result,[{profileId:'powershell',label:'Windows PowerShell',available:true}]);assert.equal(Object.isFrozen(result),true);assert.equal(Object.isFrozen(result[0]),true);});
test('profile resolver returns absolute fixed interactive PowerShell envelope without commands',async()=>{const {catalogue:a}=await fixture();const result=await a.resolveShellProfile('powershell');assert.deepEqual(Object.keys(result).sort(),['args','env','executable']);assert.equal(result.executable,executable);assert.deepEqual(result.args,['-NoLogo','-NoProfile']);assert.equal(result.env.PATH,'C:\\Windows\\System32');assert.equal(result.env.SystemRoot,'C:\\Windows');assert.equal(Object.isFrozen(result),true);assert.equal(Object.isFrozen(result.args),true);assert.equal(Object.isFrozen(result.env),true);});
test('profile missing native OS root or executable remains unavailable without PATH fallback',async()=>{for(const getSystemDirectory of [async()=>null,async()=>'',async()=> 'relative',async()=>{throw Error('private provider details');}]){const {catalogue:a,state}=await fixture({getSystemDirectory});assert.deepEqual(await a.listShellProfiles(),[{profileId:'powershell',label:'Windows PowerShell',available:false}]);await rejects(()=>a.resolveShellProfile('powershell'),'PROFILE_UNAVAILABLE');assert.equal(state.calls.includes('inspect'),false);}const {catalogue:a}=await fixture({inspectExecutable:async()=>null});assert.equal((await a.listShellProfiles())[0].available,false);await rejects(()=>a.resolveShellProfile('powershell'),'PROFILE_UNAVAILABLE');});
test('profile unknown optional ids and caller startup arguments cannot select a shell',async()=>{const {catalogue:a,state}=await fixture();for(const id of ['cmd','pwsh','C:\\evil.exe','powershell -Command x',null,{},'toString'])await rejects(()=>a.resolveShellProfile(id),'PROFILE_UNAVAILABLE');assert.equal(state.calls.length,0);await rejects(()=>a.resolveShellProfile('powershell',{args:['-Command','x']}),'REQUEST_REFUSED');await rejects(()=>a.listShellProfiles({env:{NODE_OPTIONS:'x'}}),'REQUEST_REFUSED');});
test('profile revalidates pinned executable and directory identities after discovery',async()=>{for(const mutation of [s=>{s.file.identity='new-file';},s=>{s.file.ancestors[1].identity='new-dir';},s=>{s.file.canonicalPath='D:\\powershell.exe';},s=>{s.file.file=false;},s=>{s.file.reparse=true;},s=>{s.file.ancestors[1].reparse=true;}]){const {catalogue:a,state}=await fixture();assert.equal((await a.listShellProfiles())[0].available,true);mutation(state);await rejects(()=>a.resolveShellProfile('powershell'),'PROFILE_UNAVAILABLE');}});
test('profile refuses native file evidence with missing ancestry identity or accessor fields',async()=>{let reads=0;const bad=file(executable);Object.defineProperty(bad,'identity',{enumerable:true,get(){reads++;return 'identity';}});for(const inspected of [bad,{...file(executable),identity:''},{...file(executable),ancestors:[]},{...file(executable),ancestors:file(executable).ancestors.slice(1)}]){const {catalogue:a}=await fixture({inspectExecutable:async()=>inspected});await rejects(()=>a.resolveShellProfile('powershell'),'PROFILE_UNAVAILABLE');}assert.equal(reads,0);});
test('profile environment strips injection keys without mutating native OS snapshot',async()=>{const {catalogue:a,state}=await fixture({privateEnvironmentKeys:['APP_ACCOUNT_TOKEN']});Object.assign(state.env,{nOdE_oPtIoNs:'--require evil',NODE_PATH:'evil',electron_run_as_node:'1',ELECTRON_NO_ASAR:'1',Electron_Extra_Launch_Args:'evil',VSCODE_INJECTION:'evil',CHROME_LOG_FILE:'private',PSModulePath:'application-injected-modules',SIREN_PIN:'1494',APP_ACCOUNT_TOKEN:'secret','ProgramFiles(x86)':'C:\\Program Files (x86)'});const original={...state.env};const result=await a.resolveShellProfile('powershell');assert.deepEqual({...result.env},{SystemRoot:'C:\\Windows',PATH:'C:\\Windows\\System32',TEMP:'C:\\Temp',USERNAME:'human','ProgramFiles(x86)':'C:\\Program Files (x86)'});assert.deepEqual(state.env,original);});
test('profile refuses duplicate case-folded environment variables and non-data snapshots',async()=>{let reads=0;const accessor={};Object.defineProperty(accessor,'PATH',{enumerable:true,get(){reads++;return 'evil';}});for(const env of [{PATH:'a',Path:'b'},accessor,Object.assign(Object.create({PATH:'inherited'}),{TEMP:'x'}),{PATH:1},{PATH:'bad\0value'},{PATH:'bad\ud800'},{PATH:'x'.repeat(32769)}]){const {catalogue:a,state}=await fixture();state.env=env;await rejects(()=>a.resolveShellProfile('powershell'),'PROFILE_UNAVAILABLE');}assert.equal(reads,0);});
test('profile total environment budget refuses oversized aggregate without silent truncation',async()=>{const {catalogue:a,state}=await fixture();state.env=Object.fromEntries(Array.from({length:100},(_,i)=>['VAR_'+i,'x'.repeat(3000)]));await rejects(()=>a.resolveShellProfile('powershell'),'PROFILE_UNAVAILABLE');});
test('profile scope is checked after OS-directory and executable awaits on list',async()=>{for(const boundary of ['system','inspect']){const {catalogue:a,state}=await fixture();state.hook=async type=>{if(type===boundary)state.generation++;};await rejects(()=>a.listShellProfiles(),'SENDER_REFUSED');assert.equal(state.calls.at(-1),boundary);}});
test('profile scope is checked after each resolve await including environment snapshot',async()=>{for(const boundary of ['system','inspect','env']){const {catalogue:a,state}=await fixture();state.hook=async type=>{if(type===boundary)state.generation++;};await rejects(()=>a.resolveShellProfile('powershell'),'SENDER_REFUSED');assert.equal(state.calls.at(-1),boundary);}});
test('profile revoke never revives an old asynchronous discovery and dispose is permanent',async()=>{let release;const {catalogue:a,state}=await fixture();state.hook=type=>type==='system'?new Promise(r=>release=r):Promise.resolve();const old=a.listShellProfiles();a.revoke();state.hook=async()=>{};assert.equal((await a.listShellProfiles())[0].available,true);release();await rejects(()=>old,'SENDER_REFUSED');a.dispose();await rejects(()=>a.resolveShellProfile('powershell'),'SENDER_REFUSED');});
test('profile concurrent operations are bounded without permanently consuming capacity on failure',async()=>{let release;const {catalogue:a,state}=await fixture({maxPending:1});state.hook=type=>type==='system'?new Promise(r=>release=r):Promise.resolve();const pending=a.listShellProfiles();await rejects(()=>a.listShellProfiles(),'CAPACITY_EXCEEDED');release();await pending;state.hook=async()=>{};assert.equal((await a.listShellProfiles())[0].available,true);});
test('profile asynchronous truthy or throwing authorization cannot discover a shell',async()=>{for(const authorize of [()=>1,()=>Promise.resolve(true),()=>{throw Error('lost');}]){const {catalogue:a,state}=await fixture({authorize});await rejects(()=>a.listShellProfiles(),'SENDER_REFUSED');assert.deepEqual(state.calls,[]);}});
test('usable native profile envelope never becomes a renderer supplied create authority',async()=>{let actualHostDispatch=0;const {catalogue:a}=await fixture();const envelope=await a.resolveShellProfile('powershell');for(const extra of [{executable:envelope.executable},{args:envelope.args},{env:envelope.env},{command:'hidden run'},{projectId:'forged'}]){const result=await dispatchTerminalRequest({method:'terminalCreate',payload:{operationId:'op1',epoch:7,cwdId:'cwd1',profileId:'powershell',cols:80,rows:24,...extra},dispatch:()=>{actualHostDispatch++;return {ok:true};}});assert.equal(result.code,'REQUEST_REFUSED');}assert.equal(actualHostDispatch,0);});
